# Copy to .env and adjust. Every value is optional; defaults are shown.
# The ERP reads .env from the repository folder on start (already-set environment variables win).

# SQLite database file. Relative paths are resolved from the repository folder.
WORKBENCH_ERP_DB=./data/erp.db

# Company name shown in the web UI (can also be changed later in Settings).
WORKBENCH_COMPANY_NAME=Open Workbench

# 1 = load clearly labelled SAMPLE data (demo printer, sample filaments, example prices). Use only for trying it out.
WORKBENCH_ERP_DEMO_SEED=0

# Web server bind address and port (used by run.sh and the systemd unit).
WORKBENCH_ERP_HOST=127.0.0.1
WORKBENCH_ERP_PORT=8000

# Printer model that approved G-code must come from (substring of OrcaSlicer's `printer_model` header).
WORKBENCH_PRINTER_MODEL=Centauri Carbon
# Machine card created by the "default machine card" helper.
WORKBENCH_MACHINE_NAME=Elegoo Centauri Carbon

# Optional OrcaSlicer CLI slicing (MCP tools `dilimle` / `orca_profilleri`).
# Folder layout: <dir>/machine/*.json, <dir>/process/*.json, <dir>/filament/*.json
WORKBENCH_ORCA_PROFILES=./examples/orca
WORKBENCH_ORCA_MACHINE=Elegoo Centauri Carbon 0.4 nozzle
WORKBENCH_ORCA_PROCESS=Workbench Standart 0.20 Utulu
WORKBENCH_ORCA_FILAMENT=Elegoo PLA Matte @ECC
# ORCA_BIN=/path/to/orcaslicer   (default: `orcaslicer` on PATH or ~/.local/bin/orcaslicer)
